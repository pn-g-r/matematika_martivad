# Django Core Settings
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=matmartivad.ge,www.matmartivad.ge,127.0.0.1,localhost

# Site Public Domain (Required for Flitt Webhook & Callback URLs)
# E.g. https://matmartivad.ge (No trailing slash)
SITE_URL=https://matmartivad.ge

# Flitt Payment Gateway Credentials
# Replace with your production merchant ID and secret from the Flitt merchant portal
FLITT_MERCHANT_ID=1549901
FLITT_SECRET_KEY=test
FLITT_CHECKOUT_URL=https://pay.flitt.com/api/checkout/url
